{
  "name": "designjanala",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@designjanala/web",
    "dev:dashboard": "turbo run dev --filter=@designjanala/dashboard --filter=@designjanala/api",
    "dev:api": "turbo run dev --filter=@designjanala/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "npm run e2e -w @designjanala/e2e"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
