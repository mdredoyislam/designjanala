# Base URL of the DesignJanala API (apps/api).
API_URL=https://designjanala.vercel.app
# Must match API_TOKEN on the API. Leave empty in local dev if the API has no token.
API_TOKEN=

# Email for signing in to the dashboard. Optional; when set, sign-in asks for it too.
DASHBOARD_EMAIL=
# Password for signing in to the dashboard. Required in production; leave empty in local dev to skip sign-in.
DASHBOARD_PASSWORD=12345678
# Signs the sign-in cookie. Any long random string (e.g. `openssl rand -base64 32`). Defaults to DASHBOARD_PASSWORD.
SESSION_SECRET=

# The public website (apps/web), for image previews and to refresh it after content edits.
WEB_URL=https://designjanala.vercel.app
# Must match REVALIDATE_SECRET on the website. Without it, edits appear on the site within 5 minutes.
REVALIDATE_SECRET=
