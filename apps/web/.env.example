# Where contact-form submissions are POSTed as JSON (Zapier, Make, Slack workflow, Formspree, etc.).
# Required in production — without it the form asks visitors to email project@designjanala.com instead.
CONTACT_WEBHOOK_URL=

# Base URL of the DesignJanala API (apps/api). When set, the site shows the content edited in the dashboard,
# contact-form leads are saved there, and uploaded images are served under /uploads. Without it the site
# shows its built-in default content.
API_URL=

# Shared secret the dashboard sends to /api/revalidate so content edits appear immediately.
# Must match REVALIDATE_SECRET in apps/dashboard. Without it, edits appear within 5 minutes.
REVALIDATE_SECRET=
