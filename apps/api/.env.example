# Port the API listens on.
PORT=4000
# Shared secret for the dashboard (leads, content edits, uploads). Required in production; leave empty in local dev to skip auth.
API_TOKEN=
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Where leads, content edits and uploaded images are stored (default: ./data). Use a persistent disk in production.
DATA_DIR=
